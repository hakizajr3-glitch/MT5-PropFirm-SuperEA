# TradeLocker bot preset - GBPUSD (prop-safe, optimized 2010-2026)
# Backtest (daily): profit factor ~1.9, win ~58%, max drawdown ~8%.
# Usage: copy these values into your tradelocker_bot/.env (keep your own
# credentials), or:  cp presets/gbpusd.env ../.env  then add credentials.

# ---- credentials: fill these in ----
TL_ENVIRONMENT=https://demo.tradelocker.com
TL_USERNAME=your_email@example.com
TL_PASSWORD=your_password
TL_SERVER=YOUR_BROKER_SERVER
TL_ACCOUNT_ID=

# ---- strategy (validated on daily bars) ----
TL_SYMBOL=GBPUSD
TL_RESOLUTION=1D
TL_LOOKBACK=400D
TL_FAST_EMA=15
TL_SLOW_EMA=100
TL_ATR_PERIOD=14
TL_SL_ATR=1.0
TL_TP_ATR=4.0
TL_USE_RSI=true
TL_RSI_PERIOD=14
TL_RSI_BUY_MIN=50
TL_RSI_SELL_MAX=50

# ---- risk (prop-safe) ----
TL_USE_RISK_PERCENT=true
TL_RISK_PERCENT=1.5
TL_MAX_OPEN=1
# Forex standard lot = 100000 units per 1.0 lot. VERIFY with your broker.
TL_CONTRACT_SIZE=100000

# ---- prop-firm guardrails ----
TL_MAX_DAILY_LOSS_PCT=5.0
TL_MAX_TOTAL_DD_PCT=10.0
TL_CLOSE_ON_DAILY_STOP=true
TL_CLOSE_ON_TOTAL_STOP=true

# ---- session / exits ----
TL_USE_SESSION=true
TL_START_HOUR=7
TL_END_HOUR=20
TL_TRADE_MONDAY=true
TL_TRADE_FRIDAY=true
TL_USE_BREAKEVEN=true
TL_BE_TRIGGER_ATR=1.0
TL_BE_LOCK_ATR=0.1
TL_USE_TRAILING=true
TL_TRAIL_START_ATR=1.5
TL_TRAIL_STEP_ATR=1.0

# ---- runtime ----
TL_POLL_SECONDS=300
TL_STATE_FILE=.tl_bot_state.json
TL_DRY_RUN=true
TL_LOG_LEVEL=INFO
