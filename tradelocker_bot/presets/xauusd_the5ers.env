# PropFirm SuperEA v4.0 - XAUUSD for The5ers
# Conservative preset for The5ers (tighter DD limit: 6% total, no daily).

TL_SYMBOL=XAUUSD
TL_RESOLUTION=1H
TL_LOOKBACK=60D

# Strategy
TL_FAST_EMA=20
TL_SLOW_EMA=100
TL_ATR_PERIOD=14
TL_SL_ATR=2.0
TL_TP_ATR=4.0
TL_USE_RSI=true
TL_RSI_PERIOD=14
TL_RSI_BUY_MIN=50
TL_RSI_SELL_MAX=50

# Enhanced filters (v4.0) - all enabled for maximum selectivity
TL_USE_ADX=true
TL_ADX_PERIOD=14
TL_ADX_MIN=25
TL_USE_MACD=true
TL_MACD_FAST=12
TL_MACD_SLOW=26
TL_MACD_SIGNAL=9
TL_USE_EMA200=true
TL_EMA200_PERIOD=200
TL_USE_VOL_FILTER=true
TL_VOL_LOOKBACK=50
TL_VOL_MIN=0.5
TL_VOL_MAX=2.5

# Risk - conservative for The5ers' tight DD limits
TL_USE_RISK_PERCENT=true
TL_RISK_PERCENT=0.75
TL_MAX_OPEN=1
TL_USE_ADAPTIVE_SIZING=true
TL_ADAPTIVE_MIN_PCT=0.3
TL_ADAPTIVE_MAX_PCT=1.0
TL_USE_DD_CUSHION=true
TL_DD_CUSHION_START=40

# Prop-firm guardrails (The5ers: no daily limit, 6% total with 1% buffer)
TL_MAX_DAILY_LOSS_PCT=0
TL_MAX_TOTAL_DD_PCT=5.0
TL_CLOSE_ON_DAILY_STOP=false
TL_CLOSE_ON_TOTAL_STOP=true

# Session
TL_USE_SESSION=true
TL_START_HOUR=7
TL_END_HOUR=20
TL_TRADE_MONDAY=true
TL_TRADE_FRIDAY=false

# Exits
TL_USE_BREAKEVEN=true
TL_BE_TRIGGER_ATR=1.0
TL_BE_LOCK_ATR=0.1
TL_USE_TRAILING=true
TL_TRAIL_START_ATR=1.5
TL_TRAIL_STEP_ATR=1.0
