# ==== TradeLocker credentials ====
# Use the demo host while testing; switch to the live host only when ready.
TL_ENVIRONMENT=https://demo.tradelocker.com
TL_USERNAME=your_email@example.com
TL_PASSWORD=your_password
TL_SERVER=YOUR_BROKER_SERVER
# Optional: account to trade. Accepts the account "id" (long number) or the
# short "accNum". If blank, the first account is used.
TL_ACCOUNT_ID=

# ==== Strategy ====
# Symbol names are broker-specific. Some brokers add a suffix, e.g. GATESFX
# exposes gold as XAUUSD.R and cable as GBPUSD.R. Check get_all_instruments().
TL_SYMBOL=EURUSD
TL_RESOLUTION=1H          # 1m,5m,15m,30m,1H,4H,1D ...
TL_LOOKBACK=30D           # history window for indicators
TL_FAST_EMA=20
TL_SLOW_EMA=50
TL_ATR_PERIOD=14
TL_SL_ATR=1.5             # stop loss = ATR x this
TL_TP_ATR=2.5            # take profit = ATR x this
TL_USE_RSI=true
TL_RSI_PERIOD=14
TL_RSI_BUY_MIN=50
TL_RSI_SELL_MAX=50

# ==== Money / risk management ====
TL_USE_RISK_PERCENT=true
TL_RISK_PERCENT=1.0       # risk per trade as % of balance
TL_FIXED_QTY=0.10         # used when TL_USE_RISK_PERCENT=false
TL_MAX_OPEN=1
# Money lost per 1.0 price move on 1 unit of quantity (contract size).
# Forex standard lot = 100000. Adjust per instrument for accurate sizing.
TL_CONTRACT_SIZE=100000

# ==== Prop-firm guardrails ====
TL_MAX_DAILY_LOSS_PCT=5.0
TL_MAX_TOTAL_DD_PCT=10.0
TL_CLOSE_ON_DAILY_STOP=true
TL_CLOSE_ON_TOTAL_STOP=true

# ==== Session filter (UTC hours) ====
TL_USE_SESSION=true
TL_START_HOUR=7
TL_END_HOUR=20
TL_TRADE_MONDAY=true
TL_TRADE_FRIDAY=true

# ==== Exit management (ATR multiples) ====
TL_USE_BREAKEVEN=true
TL_BE_TRIGGER_ATR=1.0
TL_BE_LOCK_ATR=0.1
TL_USE_TRAILING=true
TL_TRAIL_START_ATR=1.5
TL_TRAIL_STEP_ATR=1.0

# ==== Runtime ====
TL_POLL_SECONDS=30
TL_STATE_FILE=.tl_bot_state.json
TL_DRY_RUN=true           # set to false to send real orders
TL_LOG_LEVEL=INFO
